      ],
      "name": "3D lattice",
      "nodes": [],
      "outputs": [
        {
          "direction": "out",
          "name": "y",
          "optional": false,
          "type": null
        }
      ],
      "params": {},
      "spatial_rules": [
        {
          "axis": "z",
          "bidirectional": false,
          "id": "grid",
          "input_port": "in",
          "kind": "lattice",
          "label": "Wire every cell to the cells one grid step away, up and sideways.",

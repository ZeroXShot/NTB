{
  "name": "ntb-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NTB Studio: the graphical editor, bundled into the ntb wheel",
  "scripts": {
    "dev": "vite",
    "build": "npm run types && tsc --noEmit && vite build",
    "types": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
